# ============================================================================
#  Haven Studio & Living — environment template
#
#  Copy to `.env.local` and fill in:
#      cp .env.example .env.local
#
#  `.env.local` is git-ignored and must never be committed. This file is not.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key            # publishable, safe in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # SECRET — server only

# Set to "false" to serve the catalogue from src/lib/data.ts instead of Postgres.
# Defaults to on whenever the two NEXT_PUBLIC_SUPABASE_* values above are set.
# NEXT_PUBLIC_USE_SUPABASE_CATALOG=true

# --- Mailgun ----------------------------------------------------------------
# Dashboard → Send → Domain settings → API keys  (use a *sending* key)
MAILGUN_API_KEY=your-sending-key
MAILGUN_DOMAIN=your-domain.mailgun.org
MAILGUN_API_BASE=https://api.mailgun.net             # EU accounts: https://api.eu.mailgun.net

# Must be an address on MAILGUN_DOMAIN. Leave this unset and the app falls back
# to `Haven Studio & Living <studio@$MAILGUN_DOMAIN>`, which is almost always
# what you want — a From address on an unverified domain is rejected outright.
# MAILGUN_FROM="Haven Studio & Living <studio@your-domain.mailgun.org>"
MAILGUN_REPLY_TO=studio@example.com

# Where new-order notifications land for the studio team (optional).
# STUDIO_NOTIFICATION_EMAIL=orders@example.com

# --- Google Auth ----------------------------------------------------------
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application).
# The client *secret* is not an env var here — paste it into
# Supabase → Authentication → Providers → Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tax ---------------------------------------------------------------------
# Flat estimated sales-tax rate applied at checkout (0.08875 = 8.875% NYC).
# Swap for a real tax provider (TaxJar/Stripe Tax) before going live.
NEXT_PUBLIC_TAX_RATE=0.0
